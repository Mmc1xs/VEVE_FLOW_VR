{
  "action_manifest_version": 0,
  "alias_info": {},
  "app_key": "steam.client",
  "bindings": {
    "/actions/lasermouse": {
      "haptics": [
        {
          "output": "/actions/lasermouse/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/lasermouse/in/Pointer",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/LeftClick"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/trigger"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/Back"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/grip"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/Home"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/application_menu"
        },
        {
          "inputs": {
            "position": {
              "output": "/actions/lasermouse/in/TrackpadValue"
            },
            "touch": {
              "output": "/actions/lasermouse/in/TrackpadTouch"
            }
          },
          "mode": "trackpad",
          "path": "/user/hand/right/input/trackpad"
        }
      ]
    }
  },
  "category": "steamvr_input",
  "controller_type": "flowvr_keyboard_mouse",
  "description": "",
  "name": "Flow keyboard/mouse Steam client bindings",
  "options": {},
  "simulated_actions": []
}
